{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vermil",
  "version": "../package.json",
  "identifier": "com.vermil.tasks",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vermil",
        "decorations": false,
        "visible": false,
        "width": 1120,
        "height": 800,
        "minWidth": 400,
        "minHeight": 520,
        "backgroundColor": "#f4f1ea"
      },
      {
        "label": "quick",
        "url": "quick.html",
        "title": "Quick add",
        "width": 820,
        "height": 80,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#12110f"
      },
      {
        "label": "widget",
        "url": "widget.html",
        "title": "Vermil today",
        "width": 300,
        "height": 420,
        "minWidth": 240,
        "minHeight": 160,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "backgroundColor": "#f4f1ea"
      }
    ],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"], "createUpdaterArtifacts": true, "windows": { "nsis": { "installerHooks": "installer-hooks.nsh" } } },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGMjdDMTE3MzA5MkM1OUIKUldTYnhaSXdGOEVuajlNUlhOZnY4a3JUSkp4dS9BNnIwR05MWldzODk1L3Vvc3k5RWpNK004Z2EK",
      "endpoints": ["https://github.com/ParinTF/vermil-tasks/releases/latest/download/latest.json"]
    }
  }
}
