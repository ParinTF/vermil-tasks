{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vermil Tasks",
  "version": "../package.json",
  "identifier": "com.vermil.tasks",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vermil Tasks",
        "decorations": false,
        "width": 1120,
        "height": 800,
        "minWidth": 400,
        "minHeight": 520,
